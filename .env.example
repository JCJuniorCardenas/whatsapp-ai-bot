PORT=3000

# Token que inventás vos; tiene que coincidir con el que pongas en el panel de Meta
WHATSAPP_VERIFY_TOKEN=cambiame
# App Secret: Meta > Configuración de la app > Básica
WHATSAPP_APP_SECRET=
# Token de acceso (el temporal dura 24 hs; para algo estable, token de usuario del sistema)
WHATSAPP_TOKEN=
# ID del número de teléfono (Meta > WhatsApp > Configuración de la API)
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la Graph API
WHATSAPP_API_VERSION=v21.0

# Base de datos (PostgreSQL). Estos valores son solo para desarrollo local con Docker.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_bot

# IA (opcional). Sin GEMINI_API_KEY el bot funciona solo con comandos.
# Clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo de Gemini con plan gratis (se puede cambiar sin tocar código)
AI_MODEL=gemini-3.5-flash-lite
# Modelo de respaldo: si el principal falla (saturado, sin cuota) o no contesta a tiempo, se repite
# la consulta con este. "none" lo desactiva.
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Cuánto se espera al principal antes de pasar al respaldo, y cuánto al último modelo (milisegundos)
AI_PRIMARY_TIMEOUT_MS=12000
AI_TIMEOUT_MS=20000
# Cuánto piensa antes de responder: MINIMAL, LOW, MEDIUM, HIGH o NONE (para modelos que no lo admiten)
AI_THINKING_LEVEL=LOW
# Tope de consultas a la IA por persona por día
AI_DAILY_LIMIT=20

# Horario de atención (todo opcional; estos son los valores por defecto)
BUSINESS_NAME=
SCHEDULE_OPEN=09:00
SCHEDULE_CLOSE=18:00
SCHEDULE_SLOT_MINUTES=30
# Días de atención: 0 = domingo ... 6 = sábado. Acepta rangos y listas: 1-5, 1,3,5, 1-3,6
SCHEDULE_DAYS=1-5
# Hasta cuántos días adelante se puede reservar
SCHEDULE_MAX_DAYS_AHEAD=60

# Documentación Swagger en /docs. Por defecto: activa en desarrollo, apagada en producción.
# Poné true para publicarla (por ejemplo, para mostrarla en el portfolio).
SWAGGER_ENABLED=
